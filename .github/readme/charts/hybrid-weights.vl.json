    {"model": "Graph", "variant": "H-A (balanced)", "weight": 0.20},
    {"model": "Graph", "variant": "H-B (behavior-weighted)", "weight": 0.20},
    {"model": "Category", "variant": "H-A (balanced)", "weight": 0.20},
    {"model": "Category", "variant": "H-B (behavior-weighted)", "weight": 0.10},
    {"model": "FP-Growth", "variant": "H-A (balanced)", "weight": 0.15},
    {"model": "FP-Growth", "variant": "H-B (behavior-weighted)", "weight": 0.15},
